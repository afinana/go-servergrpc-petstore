{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Service",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": [
                "-serverAddr=localhost:8090",
                "-enableCredentials=false",
                "-mongoDatabase=petstore",
                "-mongoURI=mongodb://localhost:27017"
            ]
        },
        {
            "name": "Test Petstore Package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/petstore"
        }
    ]
}